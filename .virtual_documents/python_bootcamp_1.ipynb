seq = "AAACGCTGCGCGCAGCTACGATCGATACGATCACAGTATATTACGATCGATG"
motif = "GCGCGC"

for i in range(len(seq)):
    print(f"Checking position {i}...")
    if seq[i:(i+len(motif))] == motif:
        print(f"Found motif {motif} at position {i}")
        break





seq.index("GCGCGC")








for i in range(1, 10):
    print(f"Checking number {i}")
    if i % 3 == 0:
        print(f"{i} IS divisible by 3")
        continue
    print(f"*** {i} is NOT divisible by 3 ***")





for n in range(2, 10): # check integers 2 to 9
    for x in range(2, n): # check integers 2 to n-1
        if n % x == 0:
            print(n, 'equals', x, '*', n//x)
            break # we found a factor!
    else: # this else only applies to the inner for loop, not the outer one
        # loop fell through without finding a factor
        print(n, 'is a prime number')





