def grand_total(subtotal, tax, tip):
    return subtotal * (1 + (tax + tip))


grand_total(100, 0.07, 0.18)





grand_total(tip = 0.18, subtotal = 100, tax = 0.07)





def grand_total(subtotal, tax = 0.07, tip = 0.18): # notice the default arguments tax and tip are defined after the positional argument subtotal
    return subtotal * (1 + (tax + tip))
    
grand_total(100) # Note how this time, tax and tip were not needed to call the function





grand_total(100, tax = 0.1)





