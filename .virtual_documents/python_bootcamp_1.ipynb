def translate(codon):
    match codon:
        case 'UUU' | 'UUC' : # the | operator is an OR gate
            return 'Phe'
        case 'UUA' | 'UUG':
            return 'Leu'
        case 'UCU' | 'UCC' | 'UCA' | 'UCG':
            return 'Ser'
        case 'UAU' | 'UAC':
            return 'Tyr'
        case _:
            return "I don't know :("


print(translate('UUU'))
print(translate('UAC'))
print(translate('AAA'))





